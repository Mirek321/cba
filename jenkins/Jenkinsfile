pipeline {
    agent {
        label 'docker-test'
    }
    environment {
        DOCKER_HOST_IP = '172.26.87.236'
        UE1_IMEI = '356938035643803'
        UE1_IMEISV = '4370816125816151'
        UE1_IMSI = '001011234567895'
        UE1_KI = '8baf473f2f8fd09487cccbd7097c6862'
        UE1_OP = '11111111111111111111111111111111'
        UE1_AMF = '8000'
    }

    stages {
        stage('Debug') {
            steps {
                sh '''
            docker ps
        '''
            }
        }
        stage('Github Checkout') {
            steps {
                git 'https://github.com/herlesupreeth/docker_open5gs.git'
            }
        }
        stage('Docker Build docker_open5gs') {
            steps {
                dir('base') {
                    sh ''' if ! docker image inspect docker_open5gs:latest >/dev/null 2>&1; then
                            docker build -t docker_open5gs:latest .
                        fi'''
                }
            }
        }
            stage('Docker Build docker_srslte') {
            steps {
                dir('srslte') {
                    sh ''' if ! docker image inspect docker_srslte:latest >/dev/null 2>&1; then
                            docker build -t docker_srslte:latest .
                        fi'''
                }
            }
            }

        stage('Docker Build docker_srsran') {
            steps {
                dir('srsran') {
                    sh ''' if ! docker image inspect docker_srsran:latest >/dev/null 2>&1; then
                            docker build -t docker_srsran:latest .
                        fi'''
                }
            }
        }
        stage('Set env variables') {
            steps {
                sh '''
                    set -a
                    sed -i 's/^DOCKER_HOST_IP=.*/DOCKER_HOST_IP=172.26.87.236/' .env
                    . ./.env
                    set +a
                '''
            }
        }
        stage('Run 5G Core') {
            steps {
                sh '''
                set -a
                . ./.env
                set +a

                docker compose -f srsgnb_zmq.yaml down -v
                docker compose -f srsue_5g_zmq.yaml down -v
                docker compose -f sa-deploy.yaml down -v
                sleep 15

                docker compose -f sa-deploy.yaml up -d

                # 1. Pridanie UE (tento skript chybně uloží hodnotu do 'opc')
                docker exec webui misc/db/open5gs-dbctl add_ue_with_apn $UE1_IMSI $UE1_KI $UE1_OP internet
                docker exec webui misc/db/open5gs-dbctl update_apn $UE1_IMSI ims 0

                # 2. 🛠️ OPRAVA DATABÁZY (Moja cesta): 
                # Vynútime, aby Open5GS používal 'op' namiesto 'opc', čo presne zodpovedá dokumentácii a srsRAN.
                echo "🔧 Opravujem typ kľúča v MongoDB z 'opc' na 'op'..."
                docker exec mongo mongosh open5gs --eval '
                    db.subscribers.updateOne(
                        { imsi: "'"${UE1_IMSI}"'" }, 
                        { 
                            $set: { "security.op": "'"${UE1_OP}"'" }, 
                            $unset: { "security.opc": "" } 
                        }
                    )
                '
                docker compose -f srsgnb_zmq.yaml up -d
                docker compose -f srsue_5g_zmq.yaml up -d
                sleep 30

                echo "📊 Logy a diagnostika:"
                docker logs --tail 50 srsgnb_zmq
                docker logs --tail 50 srsue_5g_zmq
                docker container exec srsue_5g_zmq bash -c "ip addr"
                docker container exec srsue_5g_zmq bash -c "ip route"

                # Overenie, čo je skutočne v MongoDB (malo by ukazovať 'op' s hodnotou a 'opc' ako null/chýbajúce)
                echo "📊 Stav v MongoDB:"
                docker exec mongo mongosh open5gs --eval "db.subscribers.find({imsi: '${UE1_IMSI}'}, {'security.op': 1, 'security.opc': 1, 'imsi': 1}).pretty()"

                echo "📊 AMF Logy (hľadaj 'Authentication successful'):"
                docker logs --tail 30 amf
                '''
            }
        }
    }
}
